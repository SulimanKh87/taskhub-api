# =============================================================================
# terraform.tfvars.example — Example variable values
#
# Copy to terraform.tfvars and fill in real values:
#   cp terraform.tfvars.example terraform.tfvars
#
# NEVER commit terraform.tfvars — it contains real secrets.
# terraform.tfvars is in .gitignore.
# Only this .example file is committed.
# =============================================================================

aws_region  = "eu-central-1"
environment = "dev"

# -----------------------------------------------------------------------------
# Secrets — replace with real values in terraform.tfvars
# Or use environment variables:
#   export TF_VAR_db_password="your-real-password"
#   export TF_VAR_jwt_secret="your-real-secret"
# -----------------------------------------------------------------------------
db_password = "CHANGE_ME_STRONG_PASSWORD"
jwt_secret  = "CHANGE_ME_LONG_RANDOM_STRING_MIN_32_CHARS"

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
alert_email = "you@example.com"

# -----------------------------------------------------------------------------
# ECS images (update after pushing to ECR)
# -----------------------------------------------------------------------------
api_image = "123456789012.dkr.ecr.eu-central-1.amazonaws.com/taskhub-dev-api:latest"

# -----------------------------------------------------------------------------
# Sizing (defaults are fine for dev)
# -----------------------------------------------------------------------------
api_cpu           = 256
api_memory        = 512
api_desired_count = 1

worker_cpu           = 256
worker_memory        = 512
worker_desired_count = 1
