# =============================================================================
# TaskHub API - Example Environment (SAFE TO COMMIT)
# =============================================================================
# Copy to ".env" locally:
#   cp .env.example .env
# Then replace CHANGE_ME_* values.
#
# Never commit ".env" (real secrets). Only commit ".env.example".
# =============================================================================

# -----------------------------------------------------------------------------
# App (USED by app/config.py)
# -----------------------------------------------------------------------------
APP_NAME=TaskHub API
APP_ENV=dev
APP_DEBUG=false
# APP_PORT is used by app/config.py (if implemented)
APP_PORT=8000

# PORT is commonly used by platforms (ECS/Heroku-style) | for Dockerfile / ECS compatibility
PORT=8000


# Added: production-friendly logging level (harmless if unused)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Core environment used by app/config.py (THIS ONE IS USED)
# -----------------------------------------------------------------------------
ENV=dev

# -----------------------------------------------------------------------------
# Database (PostgreSQL) (USED by app/config.py)
# Format:
#   postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
# Docker Compose:
#   HOST=postgres  PORT=5432
# -----------------------------------------------------------------------------
# example: DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@postgres:5432/taskhub
DATABASE_URL=postgresql+asyncpg://taskhub:CHANGE_ME_DB_PASSWORD@postgres:5432/taskhub

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800

# Log SQL queries (USED by app/config.py)
SQL_ECHO=false

# -----------------------------------------------------------------------------
# JWT (NOTE: These are currently NOT loaded by app/config.py in your repo,
# unless you add them to Settings. They are here to match your intended config.)
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_DAYS=7

# -----------------------------------------------------------------------------
# Redis / Celery (USED by app/config.py AFTER we add it)
# Docker Compose:
#   HOST=redis
# -----------------------------------------------------------------------------
# Redis broker URL for Celery
# Local example:
# redis://localhost:6379/0
REDIS_BROKER=redis://redis:6379/0

# ==================================================
# AWS / Cloud (used by ECS runtime, not code)
# ==================================================
# AWS region where the service runs
AWS_REGION=eu-central-1

# CloudWatch log group prefix (optional but useful)
LOG_GROUP_PREFIX=/ecs/taskhub

# Added: optional AWS runtime toggles (safe placeholders)
AWS_ACCOUNT_ID=CHANGE_ME_ACCOUNT_ID
ECR_REPO_API=taskhub-api
ECR_REPO_WORKER=taskhub-worker

# ==================================================
# Optional / Future
# ==================================================
# S3 bucket for artifacts or exports
S3_BUCKET_NAME=taskhub-artifacts

# ---------------------
# AWS / EventBridge
# ---------------------
AWS_REGION=eu-central-1
EVENT_BUS_NAME=default

# ==================================================
# Secrets Manager (Production Only)
# ==================================================
# In production, secrets are stored in AWS Secrets Manager
# Terraform reads these values and creates secrets:
# - JWT_SECRET → aws_secretsmanager_secret.jwt_secret
# - DB_PASSWORD → aws_secretsmanager_secret.db_password
#
# ECS tasks retrieve secrets at runtime (no hardcoding)