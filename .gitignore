# Keep Terraform lock file tracked
# Tracking .terraform.lock.hcl ensures:
  #
  #Same provider version for everyone
  #
  #Reproducible infrastructure
  #
  #Stable CI pipelines
  #
  #No surprise upgrades
!infra/terraform/.terraform.lock.hcl

